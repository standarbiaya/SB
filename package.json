    "db:create": "wrangler d1 create portal-standar-biaya-db"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "wrangler": "^4.0.0"
  }
}
