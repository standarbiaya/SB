{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "standarbiaya",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [
    {"binding": "DB", "database_name": "portal-standar-biaya-db", "database_id": "65cc22e8-d564-42c6-9e1e-45f7ffeb3bd0"}
  ],
  "vars": { "GOOGLE_SHEET_ID": "1rH7UWjn4TAPwqd-Oa_DYV6rlaTHOeZTAo_f0_3LpDAE", "ENABLE_SCHEDULED_SYNC": "false" },
  "triggers": { "crons": ["0 1 * * *"] },
  "observability": { "enabled": true }
}
